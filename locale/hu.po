#, python-format
msgctxt "model:ir.message,text:invalid_production_state"
msgid ""
"You cannot modify the quantity of Production \"%(production)s\" because it "
"is not in state \"Draft\" or \"Waiting\"."
msgstr ""
"A(z) „%(production)s” gyártás mennyisége nem módosítható, mert nincs "
"„Piszkozat” vagy „Várakozás” állapotban."

msgctxt "model:ir.message,text:no_updateable_productions"
msgid "There is no updateable production available!"
msgstr "Nincs frissíthető gyártás!"

#, python-format
msgctxt "model:ir.message,text:production_no_related_to_sale"
msgid ""
"The Production \"%(production)s\" is not related to any sale.\n"
"In this case, you can't use this wizard but you can modify the quantity directly in production's form."
msgstr ""
"A(z) „%(production)s” gyártás nem kapcsolódik értékesítéshez.\n"
"Ebben az esetben a varázsló nem használható, de a mennyiség közvetlenül módosítható a gyártási űrlapon."

#, python-format
msgctxt "model:ir.message,text:production_with_same_origin"
msgid ""
"Cannot change Sale Line quantity because there ara more than one production "
"\"%(productions)s\" with same Sale line \"%(sale_line)s\""
msgstr ""
"Az értékesítési tétel mennyisége nem módosítható, mert több gyártás "
"(„%(productions)s”) kapcsolódik ugyanahhoz a(z) „%(sale_line)s” értékesítési"
" tételhez"

msgctxt "model:ir.message,text:quantity_already_produced"
msgid "Quantity already produced!"
msgstr "A mennyiség már le lett gyártva!"

